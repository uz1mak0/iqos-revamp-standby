# ---- Which backend does this build talk to?  aws (default) | standby ----
NEXT_PUBLIC_BACKEND=aws

# ---- standby only (Railway + Postgres + Backblaze B2) ----
# NEXT_PUBLIC_BACKEND=standby
# NEXT_PUBLIC_STANDBY_API=https://<service>.up.railway.app
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_WAREHOUSE=https://<service>.up.railway.app/wms/graphql
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_ORDER=https://<service>.up.railway.app/oms/graphql
# NEXT_PUBLIC_API_KEY=<a key listed in the standby API_KEYS>
# NEXT_PUBLIC_API_KEY_WAREHOUSE=<a key listed in the standby API_KEYS>

